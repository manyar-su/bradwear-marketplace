   gap: 2rem;
 }
 
+.catalog-top-hero {
+  position: relative;
+  width: 100vw;
+  margin-top: calc(var(--site-header-offset) * -1);
+  margin-left: calc(50% - 50vw);
+  overflow: hidden;
+  background:
+    radial-gradient(circle at top center, rgba(117, 242, 26, 0.12), transparent 42%),
+    linear-gradient(180deg, #08111e 0%, #0c1622 100%);
+}
+
+.catalog-top-hero-stage {
+  position: relative;
+  min-height: clamp(420px, 76vw, 880px);
+}
+
+.catalog-top-hero-stage::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(180deg, rgba(6, 12, 18, 0.2), rgba(6, 12, 18, 0.34));
+  pointer-events: none;
+}
+
+.catalog-top-hero-slide {
+  position: absolute;
+  inset: 0;
+  opacity: 0;
+  transform: scale(1.015);
+  transition:
+    opacity 1400ms var(--ease-smooth),
+    transform 1600ms var(--ease-smooth);
+}
+
+.catalog-top-hero-slide.is-active {
+  opacity: 1;
+  transform: scale(1);
+}
+
+.catalog-top-hero-backdrop,
+.catalog-top-hero-image {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+}
+
+.catalog-top-hero-backdrop {
+  inset: -24px;
+  width: calc(100% + 48px);
+  height: calc(100% + 48px);
+  object-fit: cover;
+  filter: blur(24px) brightness(0.42) saturate(0.82);
+  opacity: 0.78;
+  transform: scale(1.08);
+}
+
+.catalog-top-hero-image {
+  object-fit: contain;
+  object-position: center center;
+  padding:
+    calc(var(--site-header-offset) + 10px)
+    clamp(12px, 1.8vw, 28px)
+    clamp(12px, 1.8vw, 28px);
+}
+
 .catalog-page-hero,
 .catalog-filter-band,
 .catalog-product-grid,
