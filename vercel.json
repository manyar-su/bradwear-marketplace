{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "redirects": [
    {
      "source": "/client",
      "destination": "/galeri-client",
      "permanent": true
    },
    {
      "source": "/pants",
      "destination": "/celana-tactical",
      "permanent": true
    },
    {
      "source": "/layanan-pelanggan",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/temukan-toko",
      "destination": "/kontak",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.bradwearindonesia.com"
        }
      ],
      "destination": "https://bradwearindonesia.com/$1",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/(wp-admin|wp-login\\.php|xmlrpc\\.php|phpmyadmin|\\.git(?:/.*)?|\\.svn(?:/.*)?|\\.hg(?:/.*)?|\\.env(?:\\..*)?|server-status|cgi-bin(?:/.*)?|boaform/admin(?:/.*)?)",
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "/.*\\.(php[0-9]?|asp|aspx|cgi|pl|bak|sql|ini)$",
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)^(curl|wget|python-requests|aiohttp|httpie|go-http-client|libwww-perl|powershell)/?.*"
        }
      ],
      "mitigate": {
        "action": "challenge"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
